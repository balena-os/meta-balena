#!/bin/bash

set -e

. /usr/libexec/os-helpers-logging
. /usr/libexec/os-helpers-bootloader-config

source /usr/sbin/balena-config-vars --no-cache

runtime_fw_class_config_path="/sys/module/firmware_class/parameters/path"

if [[ -z "$OS_EXTRA_FIRMWARE_VOLUME" ]]; then
    # No extra firmware volume configured. If present in the bootloader
    # environment, it will be removed.
    bootloader_config_modify "extra_os_firmware_class_path"
else
    extra_firmware_volume_path=$(/usr/bin/balena volume inspect "${OS_EXTRA_FIRMWARE_VOLUME}" | /usr/bin/jq -r ".[].Mountpoint")
    if [ -z "${extra_firmware_volume_path}" ] || [ ! -d "${extra_firmware_volume_path}" ]; then
        # Volume should exist at this point
        fail "${extra_firmware_volume_path} - path is not set or is not a directory"
    fi

    extra_firmware_cmdline="firmware_class.path=${extra_firmware_volume_path}"
    kernel_cmdline=$(cat "/proc/cmdline")
    if echo "$kernel_cmdline" | grep -qF "${extra_firmware_cmdline}"; then
        info "OK: Kernel cmdline already configured for extra firmware search path. "
    elif [ -e "${runtime_fw_class_config_path}" ]; then
        echo -n "${extra_firmware_volume_path}" > "${runtime_fw_class_config_path}"
        info "OK: \"${extra_firmware_volume_path}\" has been set in \"${runtime_fw_class_config_path}\""
    else
        warn "\"${runtime_fw_class_config_path}\" - path does not exist, please check kernel configuration."
    fi
    # The next boot accepts this value only after extrafw sanitizes it.
    bootloader_config_modify "extra_os_firmware_class_path" "${extra_firmware_cmdline}"
fi
