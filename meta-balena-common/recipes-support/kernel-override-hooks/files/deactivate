#!/bin/sh
#
# kernel-override-hooks: deactivate hook
#
#
# Env vars expected:
#   EXTENSION_IMAGE_KERNEL_ABI_ID - sha256 of the extension's kernel image
#

set -eu

# This hook runs as the copy create persisted into the /boot volume, and the
# manager invokes it with EXTENSION_ROOTFS pointing at that volume rather than
# at an extension rootfs.
# shellcheck disable=SC1091
. /usr/libexec/os-helpers-logging
# shellcheck disable=SC1091
. /usr/libexec/os-helpers-bootenv

BOOT_BY_ABI_DIR="/mnt/data/boot-by-abi"
OVERRIDE_REJECTED="/mnt/state/override-rejected"

ABI="${EXTENSION_IMAGE_KERNEL_ABI_ID:-}"
if [ -z "${ABI}" ]; then
    info "no kernel-abi-id label; not a kernel-override extension, nothing to do"
    exit 0
fi

if BOOTENV_FILE=$(bootenv_locate); then
    CURRENT=$(bootenv_get "${BOOTENV_FILE}" "kernel_override_abi")
    if [ "${CURRENT}" = "${ABI}" ]; then
        bootenv_unset "${BOOTENV_FILE}" "kernel_override_abi"
        sync
        info "cleared active kernel_override_abi=${ABI}"
    fi
fi

TARGET="${BOOT_BY_ABI_DIR}/${ABI}"
if [ -L "${TARGET}" ]; then
    rm -f "${TARGET}"
    sync -f "${BOOT_BY_ABI_DIR}"
    info "removed boot-by-abi/${ABI} symlink"
fi

# Withdrawing the extension withdraws the question, so a rejection recorded
# against this ABI goes with it. Without this an operator could never retry
# the same build after fixing whatever it broke on the device.
if [ "${EXTENSION_REJECTED:-0}" != "1" ]; then
    if [ -r "${OVERRIDE_REJECTED}" ] && [ "$(cat "${OVERRIDE_REJECTED}")" = "${ABI}" ]; then
        rm -f "${OVERRIDE_REJECTED}"
        sync -f /mnt/state || true
        info "cleared the health-validation rejection recorded for ${ABI}"
    fi
    if [ -n "${BOOTENV_FILE:-}" ] &&
        [ "$(bootenv_get "${BOOTENV_FILE}" "kernel_override_abi_rejected")" = "${ABI}" ]; then
        bootenv_unset "${BOOTENV_FILE}" "kernel_override_abi_rejected"
        sync
        info "cleared the unconsumed rejection relay for ${ABI}"
    fi
fi
