#
# Single-key get/set/unset helpers for a grub-env bootloader file.
# POSIX /bin/sh compatible; safe to source from busybox sh (initrd) and
# the host OS.
#

# bootenv_get <file> <key>
#   Prints the value of <key> on stdout if present; prints nothing if
#   the key is unset, the file is missing, or grub-editenv is
#   unavailable. Return code is always 0 — callers distinguish
#   "unset" from "set to empty" by inspecting the printed value.
bootenv_get() {
    _file="$1"
    _key="$2"
    [ -n "${_file}" ] && [ -f "${_file}" ] || return 0
    [ -n "${_key}" ] || return 0
    command -v grub-editenv >/dev/null 2>&1 || return 0
    grub-editenv "${_file}" list 2>/dev/null | sed -n "s/^${_key}=//p"
}

# bootenv_edit <file> <grub-editenv arguments...>
#   The block is a fixed 1024-byte read-modify-write, so two overlapping
#   writers lose a key. Every writer in the running OS serialises on an flock
#   of the file, the extension runtime included; the initramfs writers run
#   before any of them exist and take none.
#
#   flock opens with O_CREAT and would leave an empty block that grub-editenv
#   reads instead of creating, so lay the block down first.
bootenv_edit() {
    _file="$1"
    shift
    [ -s "${_file}" ] || grub-editenv "${_file}" create
    flock "${_file}" grub-editenv "${_file}" "$@"
}

# bootenv_set <file> <key> <value>
bootenv_set() {
    bootenv_edit "$1" set "$2=$3"
}

# bootenv_unset <file> <key>
bootenv_unset() {
    bootenv_edit "$1" unset "$2"
}

# bootenv_restore_kernel_override <file> <slot>
#   Roll the active override back to <slot>'s last committed one.
#   An empty/unset committed value clears the override so the device
#   boots the stock kernel.
bootenv_restore_kernel_override() {
    _f="$1"
    _slot="$2"
    _committed=$(bootenv_get "${_f}" "kernel_override_abi_committed_${_slot}")
    if [ -n "${_committed}" ]; then
        bootenv_set "${_f}" "kernel_override_abi" "${_committed}"
    else
        bootenv_unset "${_f}" "kernel_override_abi"
    fi
}

# bootenv_reject_kernel_override <file> <slot> [booted_abi]
bootenv_reject_kernel_override() {
    _f="$1"
    _slot="$2"
    _active=$(bootenv_get "${_f}" "kernel_override_abi")
    _committed=$(bootenv_get "${_f}" "kernel_override_abi_committed_${_slot}")
    _booted="${3-${_active}}"
    if [ -n "${_active}" ] && [ "${_active}" != "${_committed}" ] &&
        [ "${_active}" = "${_booted}" ]; then
        bootenv_set "${_f}" "kernel_override_abi_rejected" "${_active}"
    fi
    bootenv_restore_kernel_override "${_f}" "${_slot}"
}
