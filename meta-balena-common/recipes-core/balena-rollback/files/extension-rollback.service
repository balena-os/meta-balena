[Unit]
Description=Balena validates a kernel override armed by an extension
DefaultDependencies=no
Requires=resin-boot.service resin-state.service resin-data.service mnt-sysroot-active.service
Wants=openvpn.service balena.service
# Pulls in the engine and the VPN but is deliberately not ordered after them.
#
# Ordered after both rollback units because each settles state this reads.
#
# Unconditional by design, unlike rollback-health: an override can be armed
# outside a host OS update, so there is no breadcrumb to gate on. The window is
# derived from the bootenv, which an ordinary boot reads once.
After=resin-boot.service resin-state.service resin-data.service mnt-sysroot-active.service systemd-udev-settle.service rollback-altboot.service rollback-health.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/balena-extension-manager validate --settle 60 --retry 60 --attempts 15

[Install]
WantedBy=multi-user.target
