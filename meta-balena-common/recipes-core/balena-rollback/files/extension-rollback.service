[Unit]
Description=Balena validates a kernel override armed by an extension
DefaultDependencies=no
Requires=resin-boot.service mnt-sysroot-active.service
Wants=openvpn.service balena.service
# Ordered after the engine and the VPN because those are what the health checks
# judge, and after both rollback units because each settles state this reads.
#
# Unconditional by design, unlike rollback-health: an override can be armed
# outside a host OS update, so there is no breadcrumb to gate on. The window is
# derived from the bootenv, and an ordinary boot costs three reads.
After=resin-boot.service mnt-sysroot-active.service openvpn.service balena.service systemd-udev-settle.service rollback-altboot.service rollback-health.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh /usr/bin/extension-rollback

[Install]
WantedBy=multi-user.target
