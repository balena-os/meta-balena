#!/bin/sh

# shellcheck disable=SC1091
. /usr/libexec/os-helpers-logging
# shellcheck disable=SC1091
. /usr/libexec/os-helpers-bootenv

# Substituted at build time from ALLOWED_BOOTARGS_LIST.
ALLOWED_BOOTARGS="@@ALLOWED_BOOTARGS@@"

extrafw_enabled() {
    # Only run this inside the balena bootloader
    # shellcheck disable=SC2154
    if [ "$bootparam_balena_stage2" != "true" ]; then
        return 1
    fi

    # shellcheck disable=SC2154
    if [ "$bootparam_flasher" = "true" ]; then
        return 1
    fi

    # BOOTENV_FILE must be defined and exist
    if [ -z "${BOOTENV_FILE}" ] || [ ! -f "${BOOTENV_FILE}" ]; then
        return 1
    fi

    return 0
}

extrafw_run() {
    EXTRA_FW_ARG=$(bootenv_get "${BOOTENV_FILE}" "extra_os_firmware_class_path")

    # Nothing to do if undefined
    if [ -z "${EXTRA_FW_ARG}" ]; then
        return 0
    fi

    # The bootenv is unauthenticated: accept only what the writer may set.
    case "${EXTRA_FW_ARG}" in
    firmware_class.path=*)
        for _allowed in ${ALLOWED_BOOTARGS}; do
            if [ "${EXTRA_FW_ARG}" = "${_allowed}" ]; then
                export KEXEC_EXTRA_ARGS="${KEXEC_EXTRA_ARGS} ${EXTRA_FW_ARG}"
                return 0
            fi
        done
        ;;
    esac

    # Stopping the boot here would make the device unbootable, so drop
    # the extra firmware path and go on. The value is not logged.
    warn "Extra firmware path is not an allowed boot argument; ignoring it"
    return 0
}
