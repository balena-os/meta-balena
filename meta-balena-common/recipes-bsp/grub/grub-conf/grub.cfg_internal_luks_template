# Automatically created by OE
serial --unit=0 --speed=115200 --word=8 --parity=no --stop=1
default=boot
insmod ext2
insmod gzio
insmod test
insmod loadenv
insmod regexp
insmod probe
insmod configfile
timeout=@@TIMEOUT@@

load_env --skip-sig bootcount resin_root_part upgrade_available

if [ -f ${prefix}/grub_extraenv ]; then
    load_env -f ${prefix}/grub_extraenv --skip-sig extra_os_firmware_class_path
fi

# Same shape as verify_extrafw. Drop anything else.
if regexp '^firmware_class\.path=/var/lib/docker/volumes/[A-Za-z0-9/_-]+$' "${extra_os_firmware_class_path}"; then
    if regexp '//' "${extra_os_firmware_class_path}"; then
        set extra_os_firmware_class_path=
    fi
else
    set extra_os_firmware_class_path=
fi

if [ ${upgrade_available} = 1 ] ; then
 if [ ${bootcount} = 1 ] ; then
  set bootcount=2
  save_env bootcount
 fi
 if [ ${bootcount} = 0 ] ; then
  set bootcount=1
  save_env bootcount
 fi
fi

menuentry 'boot'{
set balena_root=resin-rootA
if [ ${bootcount} = 2 ] ; then
 if [ ${resin_root_part} = 3 ] ; then
  set balena_root=resin-rootB
 fi
else
 if [ ${resin_root_part} = 4 ] ; then
  set balena_root=resin-rootB
 fi
fi
linux /@@KERNEL_IMAGETYPE@@ balena_stage2 root=LABEL=${balena_root} @@KERNEL_CMDLINE@@ ${extra_os_firmware_class_path}
}

menuentry 'manualfallbackA' {
  linux /@@KERNEL_IMAGETYPE@@ balena_stage2 root=LABEL=resin-rootA @@KERNEL_CMDLINE@@ ${extra_os_firmware_class_path}
}

menuentry 'manualfallbackB' {
  linux /@@KERNEL_IMAGETYPE@@ balena_stage2 root=LABEL=resin-rootB @@KERNEL_CMDLINE@@ ${extra_os_firmware_class_path}
}
